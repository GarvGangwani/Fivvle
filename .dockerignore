# Prevents unnecessary files from being sent as Docker build context.
# Relevant when a Dockerfile-built service is added (e.g. backend image).

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets — NEVER ship these in any image
.env
.env.*
service-account.json
*-firebase-adminsdk-*.json
serviceAccountKey.json

# Version control and editor
.git/
.github/
.gitignore
.idea/
.vscode/

# Docs (large markdown files not needed in container images)
*.md
docs/

# OS
.DS_Store
Thumbs.db
