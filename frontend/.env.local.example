# Public Firebase client config (identifiers, not secrets — see AGENTS.md).
NEXT_PUBLIC_FIREBASE_API_KEY=your-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-key-here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-key-here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-key-here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-key-here
NEXT_PUBLIC_FIREBASE_APP_ID=your-key-here

# Backend API base URL (browser calls FastAPI only).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public landing page subdomain routing (see docs/LANDING_PAGE_SUBDOMAINS.md).
NEXT_PUBLIC_LANDING_ROOT_DOMAIN=fivvle.io
NEXT_PUBLIC_LANDING_DEV_PORT=3000

# Server-only: shared with backend for on-demand ISR revalidation of /e/[slug].
REVALIDATE_SECRET=dev-local-revalidate-secret
