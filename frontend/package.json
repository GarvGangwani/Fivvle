{
  "name": "fivvle-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'),path=require('path');['.next','node_modules/.cache/fivvle-next-dev'].forEach(p=>{try{fs.rmSync(path.join(process.cwd(),p),{recursive:true,force:true})}catch(e){}})\"",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tiptap/extension-color": "2.27.2",
    "@tiptap/extension-highlight": "2.27.2",
    "@tiptap/extension-text-style": "2.27.2",
    "@tiptap/extension-underline": "2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "autoprefixer": "10.5.0",
    "firebase": "12.13.0",
    "lucide-react": "1.14.0",
    "next": "15.5.18",
    "postcss": "8.5.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "10.1.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "4.0.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.18",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.18",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.4"
  }
}
